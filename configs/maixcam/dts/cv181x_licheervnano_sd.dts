/dts-v1/;
#include "cv181x_base_riscv.dtsi"
#include "cv181x_asic_qfn.dtsi"
#include "cv181x_asic_sd.dtsi"
#include "cv181x_default_memmap.dtsi"

#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#ifndef __UBOOT__
#include <dt-bindings/mailbox/cvitek-mailbox.h>
#endif

&sd {
        min-frequency = <400000>; // 400Khz
        //max-frequency = <50000000>; // 50Mhz
        max-frequency = <25000000>; // 25Mhz
        //max-frequency = <10000000>; // 10Mhz
        //max-frequency = <5000000>; // 5Mhz
};

&fast_image {
	reg = <0x0 CVIMMAP_FREERTOS_ADDR 0x0 CVIMMAP_RTOS_FIRMWARE_SIZE>;
};

&dmac {
	/*
	 * The C906L owns this DesignWare AXI DMAC (SPI/IMU and the remote core's only
	 * DMA). Linux must not probe it: writing the controller's global registers from
	 * two cores races the AXI fabric and has hung the SoC on a remoteproc restart.
	 * Its Linux clients on this board (spinand, i2s0..3) are not populated.
	 */
	status = "disabled";
};

/*
 * SPI2 is the IMU bus on the C906L side.  It has no Linux client on this board, so
 * leaving it enabled only lets dw-apb-ssi probe the controller and take its reset and
 * clock away from the remote core.  Declaring it disabled gives each controller one
 * owner; the C906L firmware configures it unconditionally at bring-up.
 */
&spi2 {
	status = "disabled";
};

/delete-node/ &vdev0vring0;
/delete-node/ &vdev0vring1;
/delete-node/ &vdev0buffer;


&uart1 {
        status = "okay";
};

&mipi_tx {
	status = "disabled";
};

&i2c4 {
        statuc = "okay";
        gt9xx: gt9xx@14 {
                compatible = "goodix,gt911";
                reg = <0x14>;
		interrupts = <3 0 IRQ_TYPE_EDGE_FALLING>;
		interrupt-parent = <&porte>;
                irq-gpios= <&porte 3 0>;
                reset-gpios = <&porte 4 0>;
                status = "disabled";
        };
};


&dac {
        status = "disabled";
        /delete-property/ mute-gpio-r;
};

&ethernet0 {
	status = "disabled";
};

&mipi_rx {
        snsr-reset = <&porte 1 GPIO_ACTIVE_LOW>;
};

&soc_thermal_0 {
	cooling-maps {
		map0 {
			trip = <&soc_thermal_trip_0>;
			cooling-device = <&cv181x_cooling THERMAL_NO_LIMIT 1>;
		};
		map1 {
			trip = <&soc_thermal_trip_1>;
			cooling-device = <&cv181x_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
		};
	};
};

/ {
        model = "Sipeed MaixCAM";

	reserved-memory {
		/* The 132 KiB sg2002-ipc shared memory that used to sit at
		 * 0x8FFDE000 is gone with the retired camera bridge: its band is
		 * folded into fast_image, so the firmware region stays one
		 * gap-free reserved range ending at the boot-trace page.
		 * 原 sg2002-ipc 共享内存随相机桥退役；这段带宽并入 fast_image，
		 * 固件区因此仍是“到 boot-trace 页为止”的一整块保留区。 */
		rtos_boot_trace: boot-trace@8ffff000 {
			reg = <0x0 CVIMMAP_RTOS_BOOT_TRACE_ADDR 0x0 CVIMMAP_RTOS_BOOT_TRACE_SIZE>;
			no-map;
			cvitek,boot-trace;
		};
	};

	/delete-node/ saradc;
	/delete-node/ rtc;

	/delete-node/ wifi_pin;
	/delete-node/ bt_pin;
	/delete-node/ sound_adc;
	/delete-node/ sound_dac;
	/delete-node/ sound_PDM;

        gpio-keys {
                compatible = "gpio-keys";
                key-user {
                        label = "User Key";
                        linux,code = <KEY_DISPLAYTOGGLE>;
                        debounce-interval = <1>;
                        gpios = <&porta 30 1>;
                };
        };

        wifisd:wifi-sd@4320000 {
                compatible = "cvitek,cv181x-sdio";
                bus-width = <4>;
                reg = <0x0 0x4320000 0x0 0x1000>;
                reg_names = "core_mem";
                src-frequency = <375000000>;
                min-frequency = <400000>; // 400Khz
                //max-frequency = <50000000>; // 50Mhz
                //max-frequency = <45000000>; // 45Mhz
                //max-frequency = <40000000>; // 40Mhz
                //max-frequency = <35000000>; // 35Mhz
                //max-frequency = <30000000>; // 30Mhz
                max-frequency = <25000000>; // 25Mhz
                //max-frequency = <20000000>; // 20Mhz
                //max-frequency = <15000000>; // 15Mhz
                //max-frequency = <10000000>; // 10Mhz
                //max-frequency = <5000000>; // 5Mhz
                64_addressing;
                reset_tx_rx_phy;
                non-removable;
                pll_index = <0x7>;
                pll_reg = <0x300207C>;
                no-mmc;
                no-sd;
                /*
                 * SDIO1 is reserved for the external ESP32-C5 slave in the
                 * C906 bring-up image.  Leaving the in-tree cvi host enabled
                 * makes Linux probe the same controller and race the C906
                 * remote processor (and this kernel's sdhci_cvi_remove has a
                 * NULL-pointer bug when detached at runtime).  Keep the node
                 * present for board variants that explicitly re-enable it,
                 * but do not bind the Linux driver by default.
                 */
                status = "disabled";
                interrupts = <38 IRQ_TYPE_LEVEL_HIGH>;
                interrupt-parent = <&plic0>;
        };

        leds {
        	compatible = "gpio-leds";
	        led0 {
		        gpios = <&porta 14 GPIO_ACTIVE_LOW>;
		        linux,default-trigger = "heartbeat";
		        function = LED_FUNCTION_HEARTBEAT;
	        };
        };
#ifndef __UBOOT__        
	/*
	 * The two 4 KiB pages the C906L firmware shares with Linux: console (index 0)
	 * and shared page (index 1).  They sit inside fast_image, which already
	 * reserves the range, so this node reserves nothing -- it gives userspace a
	 * mapping through UIO and a stable name.
	 * No interrupts: mailbox IRQ 101 belongs to cv181x_rtos_cmdqu alone, and the
	 * firmware notification rides its RTOS_CMDQU_WAIT_EVENT ioctl.
	 * 两个 4 KiB 页（console = map 0，共享页 = map 1）：它们落在 fast_image 里，
	 * 这里只提供 UIO 映射和一个稳定的名字。不带中断：mailbox 的 IRQ 101 归
	 * cv181x_rtos_cmdqu 独占，固件通知走它的 RTOS_CMDQU_WAIT_EVENT。
	 */
	guidance_pages: guidance-pages@8ffdb000 {
		compatible = "generic-uio";
		reg = <0x0 0x8FFDB000 0x0 0x1000>,
		      <0x0 0x8FFDC000 0x0 0x1000>;
		reg-names = "console", "shared";
		linux,uio-name = "guidance-pages";
	};

	rtos_cmdqu {
		/* Only the mailbox page: the driver reads resource 0, and the old
		 * "shared-memory" resource was the retired camera ring's window. */
		reg = <0x0 0x01900000 0x0 0x1000>;
		reg-names = "mailbox";
	};

        mbox: mbox@0x01900000 {
                compatible = "cvitek,sg200x-mailbox";
		reg = <0x0 0x01900000 0x0 0x1000>;
		reg-names = "mailbox";
                interrupts	= <101 IRQ_TYPE_LEVEL_HIGH>;
                interrupt-parent = <&plic0>;
                status = "okay";
                #mbox-cells = <4>;
        };

        cv181x-c906_1 {
		compatible	= "cvitek,cv181x-c906_1";
		/* The mailbox-only firmware has no RPMsg resource table. */
		memory-region	= <&fast_image &rtos_boot_trace>;
                firmware        = "c906-mcu.elf";
                resets		= <&rst RST_C906_1>;
		reset-names	= "sw_reset";
                clocks		= <&clk CV181X_CLK_C906_1>;
                clock-names     = "clk_c906_1";
                mboxes		= <&mbox 0 CVITEK_MBOX_DIRECTION_TX CVITEK_MBOX_C906_1 1>, <&mbox 1 CVITEK_MBOX_DIRECTION_RX CVITEK_MBOX_C906_1 1>;
	        mbox-names	= "vq_tx", "vq_rx";
                status		= "okay";
	};
#endif
};
