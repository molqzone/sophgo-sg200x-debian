diff --git a/plat/cv180x/platform.c b/plat/cv180x/platform.c
index 9fd73ca..a053ac7 100644
--- a/plat/cv180x/platform.c
+++ b/plat/cv180x/platform.c
@@ -78,6 +78,26 @@ void __system_reset(const char *file, unsigned int line)
 	__builtin_unreachable();
 }
 
+/*
+ * 热复位（SBI SRST）只复位大核，C906L 不在它管的范围里：上一轮启动的核会继续从 DDR 取指，
+ * 而 BL2 紧接着要重新训练 DDR —— 一个还在使用 DDR 的核会让 SoC 在打印任何东西之前就卡死。
+ * 这就是"上电只有小核灯闪、大核永远不起来"的成因。
+ *
+ * A warm reset leaves the C906L running, and BL2 then re-trains DDR underneath it.  Hold
+ * the core down *before* load_ddr(): clock off, entry address zeroed, and never released
+ * here -- cvitek_remoteproc releases it later, which is the remoteproc boot policy.  On a
+ * cold boot this is a no-op: POR already leaves the core in reset.
+ */
+void hold_c906l_in_reset(void)
+{
+	NOTICE("Hold C906L.\n");
+
+	mmio_clrbits_32(0x3003024, 1 << 6);
+	mmio_setbits_32(SEC_SYS_BASE + 0x04, 1 << 13);
+	mmio_write_32(SEC_SYS_BASE + 0x20, 0);
+	mmio_write_32(SEC_SYS_BASE + 0x24, 0);
+}
+
 void reset_c906l(uintptr_t reset_address)
 {
 	NOTICE("RSC.\n");
