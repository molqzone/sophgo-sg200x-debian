diff --git a/plat/cv180x/bl2/bl2_main.c b/plat/cv180x/bl2/bl2_main.c
--- a/plat/cv180x/bl2/bl2_main.c
+++ b/plat/cv180x/bl2/bl2_main.c
@@ -5,6 +5,23 @@
 #include <string.h>
 #include <delay_timer.h>
 
+/*
+ * 厂商 RTOS 的配置头不在 FSBL 构建里，这三个宏原本来自它。它们只影响 RTOS 自己的打印环
+ * 开关与 fast-image 类型；checksum 由结构体内容自身算出，因此任何自洽取值都能通过校验。
+ * The vendor RTOS config header is not part of the FSBL build.  These three values only
+ * select the RTOS's own print ring and fast-image mode; the checksum is derived from the
+ * struct itself, so any self-consistent choice validates.
+ */
+#ifndef RTOS_FAST_IMAGE_TYPE
+#define RTOS_FAST_IMAGE_TYPE 0
+#endif
+#ifndef RTOS_DUMP_PRINT_ENABLE
+#define RTOS_DUMP_PRINT_ENABLE 1
+#endif
+#ifndef RTOS_DUMP_PRINT_SZ_IDX
+#define RTOS_DUMP_PRINT_SZ_IDX 0
+#endif
+
 #ifdef RTOS_ENABLE_FREERTOS
 int init_comm_info(int ret)
 {
@@ -17,12 +34,21 @@
 	 */
 	transfer_config_s.conf_magic = RTOS_MAGIC_HEADER;
 	transfer_config_s.conf_size = ((uint64_t)&transfer_config_s.checksum - (uint64_t)&transfer_config_s.conf_magic);
-	transfer_config_s.isp_buffer_addr = CVIMMAP_ISP_MEM_BASE_ADDR;
-	transfer_config_s.isp_buffer_size = CVIMMAP_ISP_MEM_BASE_SIZE;
-	transfer_config_s.encode_img_addr = CVIMMAP_H26X_BITSTREAM_ADDR;
-	transfer_config_s.encode_img_size = CVIMMAP_H26X_BITSTREAM_SIZE;
-	transfer_config_s.encode_buf_addr = CVIMMAP_H26X_ENC_BUFF_ADDR;
-	transfer_config_s.encode_buf_size = CVIMMAP_H26X_ENC_BUFF_SIZE;
+	/*
+	 * 这块板子不让 RTOS 做 fast-image / 编码：所有 DMA 缓冲显式置 0，而不是照抄
+	 * CVIMMAP_*（那些区域要么长度为 0，要么另有主人）。RTOS 只在 size 非 0 时才用它，
+	 * 而"退回到内置默认配置"恰恰会给出不属于它的地址，上次就是那么把总线挂死的。
+	 * This board gives the RTOS no fast-image or encoder buffers: the DMA fields are
+	 * zeroed instead of copying CVIMMAP_* (sizes are zero here, or the region belongs to
+	 * someone else).  The built-in "default config" fallback is what handed the RTOS
+	 * addresses that were not its own and hung the bus.
+	 */
+	transfer_config_s.isp_buffer_addr = 0;
+	transfer_config_s.isp_buffer_size = 0;
+	transfer_config_s.encode_img_addr = 0;
+	transfer_config_s.encode_img_size = 0;
+	transfer_config_s.encode_buf_addr = 0;
+	transfer_config_s.encode_buf_size = 0;
 	transfer_config_s.dump_print_enable = RTOS_DUMP_PRINT_ENABLE;
 	transfer_config_s.dump_print_size_idx = RTOS_DUMP_PRINT_SZ_IDX;
 	transfer_config_s.image_type = RTOS_FAST_IMAGE_TYPE;
