#!/usr/bin/env python3
"""Credit the image's entropy seed before anything waits for randomness.

measured: this board's cold boot spent ~10.9 s before `crng init done`, and every unit
that needs randomness queued behind it -- `systemd-random-seed` itself says so:

    systemd-random-seed[105]: Kernel entropy pool is not initialized yet, waiting

The image ships a per-build seed, but systemd v262 *waits for* the pool before loading
it, so the seed only helps the next boot.  This unit credits it early and directly:
RNDADDENTROPY on /dev/urandom, before sysinit.target.  这是一次性注入：镜像里那份种子
每张镜像不同，设备首次启动后 systemd 会自己保存新的种子。
"""

import fcntl
import os
import struct
import sys

SEED = "/var/lib/systemd/random-seed"
RNDADDENTROPY = 0x40085203
CREDIT_BITS_PER_BYTE = 8
BUFFER = 256


def pool_info(data: bytes) -> bytes:
    """Build the `struct rand_pool_info` payload for RNDADDENTROPY.

    内核的 `struct rand_pool_info` 是 `{ int entropy_count; int buf_size; __u32 buf[]; }`
    —— **entropy_count 在第一个**。这两个字段曾经写反：内核于是按 buf_size 去读 8 倍于
    实际长度的数据，计入的熵要么是错的要么根本没到阈值，池子一直不初始化。
    症状不是"种子没用"，而是启动时好时坏：只有内核自己的抖动熵在 NCM gadget 之前攒够
    才起得来（实测 10.9 s 成功、14 s 未成就卡死），看起来像随机的"假砖头"。

    The kernel's `struct rand_pool_info` is `{ int entropy_count; int buf_size; __u32 buf[]; }`
    -- entropy_count comes **first**.  The two fields were once swapped, so the kernel read
    8x the real length and the credited entropy was either wrong or never reached the
    threshold, leaving the pool uninitialized.  The symptom was not "the seed does nothing"
    but a boot that worked only when the kernel's own jitter entropy arrived before the NCM
    gadget (measured: fine at 10.9 s, stuck at 14 s) -- a random-looking fake brick.
    """
    return struct.pack("<ii", CREDIT_BITS_PER_BYTE * len(data), len(data)) + data


def main() -> int:
    # 不要因为 `/dev/hwrng` 存在就提前返回：这颗 SoC 的 hwrng 驱动没有出现在设备树里，
    # 而"节点存在但不出数"比"节点不存在"更难查。种子永远计入，代价只是几十微秒。
    # Do not return early on `/dev/hwrng`: this SoC has no hwrng node in its device tree,
    # and "the node exists but yields nothing" is far harder to diagnose than its absence.
    # The seed is always credited; it costs tens of microseconds.
    try:
        with open(SEED, "rb") as handle:
            data = handle.read(BUFFER)
    except OSError as error:
        print("seed-entropy: cannot read %s (%s)" % (SEED, error), file=sys.stderr)
        return 1
    if len(data) < 64:
        print("seed-entropy: seed is only %d bytes" % len(data), file=sys.stderr)
        return 1
    credits = CREDIT_BITS_PER_BYTE * len(data)
    payload = pool_info(data)
    fd = os.open("/dev/urandom", os.O_WRONLY)
    try:
        fcntl.ioctl(fd, RNDADDENTROPY, payload)
    finally:
        os.close(fd)
    try:
        with open("/proc/sys/kernel/random/entropy_avail") as handle:
            available = handle.read().strip()
    except OSError:
        available = "?"
    print("seed-entropy: credited %d bytes (%d bits), entropy_avail=%s"
          % (len(data), credits, available))
    return 0


if __name__ == "__main__":
    sys.exit(main())
