[Unit]
Description=Guidance vision app (camera + detector + RTSP + recording)
# 必须排在放核之后：`rtos-mode` 会卸载整条相机链（stop_media_chain），如果应用已经
# 在推流时被卸载，内核会在 DMA 活动中释放驱动——这是唯一剩下的挂死风险，用顺序消掉，
# 不用兜底。
# Ordered after the release: `rtos-mode` unloads the whole camera chain (stop_media_chain),
# and doing that while the app is streaming releases driver state under active DMA -- the
# one remaining way to hang the big core.  Ordering removes it without a fallback.
After=guidance-core.service guidance-board-init.service
Requires=guidance-core.service
# 等板级初始化把时钟门和焊盘配好再起相机（顺序见 guidance-board-init.service 的说明）。
# Wait for the board init to configure the clocks and pads before starting the camera.  The
# ordering is explained in guidance-board-init.service.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/tmp
Environment=LD_LIBRARY_PATH=/mnt/system/usr/lib
Environment=GUIDANCE_RTSP=1
ExecStartPre=/bin/sh -c '/usr/local/bin/loadmedia.sh || true'
ExecStart=/usr/local/bin/guidance_vision_app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
