[Unit]
Description=Guidance vision app (camera + detector + RTSP + recording)
# 排在放核之后（放核由 multi-user 之后的 rtos-release 完成）。
# Ordered after the release, which rtos-release performs after multi-user.
After=rtos-release.service
# `loadmedia.sh` 从 /mnt/system 里 insmod；挂载还没就位时它只会加载到一两个模块，
# 相机随后在 `CVI_SYS_Init` 里失败（实测开机只加载到 1 个模块，手动跑则是 13 个）。
# `RequiresMountsFor` 让 systemd 先把这个挂载点准备好。
# `loadmedia.sh` insmods from /mnt/system; before that mount is up it only manages a module
# or two and the camera then fails in `CVI_SYS_Init` (measured: 1 module at boot, 13 when run
# by hand).  `RequiresMountsFor` makes systemd prepare the mount first.
RequiresMountsFor=/mnt/system
Requires=rtos-release.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/tmp
Environment=LD_LIBRARY_PATH=/mnt/system/usr/lib
Environment=GUIDANCE_RTSP=1
ExecStartPre=/bin/sh -c '/usr/local/bin/loadmedia.sh || true'
ExecStart=/usr/local/bin/guidance_vision_app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
