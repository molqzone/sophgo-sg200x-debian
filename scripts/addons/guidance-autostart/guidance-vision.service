[Unit]
Description=Guidance vision app (camera + detector + RTSP + recording)
# 排在放核之后（放核由 `guidance-release.service` 在 multi-user 达成后触发）。
# Ordered after the release, which `guidance-release.service` triggers once multi-user is up.
After=guidance-release.service
Wants=guidance-release.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/tmp
Environment=LD_LIBRARY_PATH=/mnt/system/usr/lib
Environment=GUIDANCE_RTSP=1
ExecStartPre=/bin/sh -c '/usr/local/bin/loadmedia.sh || true'
ExecStart=/usr/local/bin/guidance_vision_app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
