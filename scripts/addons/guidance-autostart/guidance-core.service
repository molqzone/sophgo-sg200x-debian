[Unit]
Description=Start the C906L (guarded: skipped if a previous attempt did not finish booting)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
# 失败回退：如果上一次放核后系统没有走到 `guidance-health`（即没写下 boot-ok），
# 说明放核把大核带死了；本次开机把尝试标记保留下来并**跳过**放核，保证系统可启动。
# Rollback: if the previous attempt never reached `guidance-health` (no boot-ok written),
# releasing the core took the big core down.  Keep the attempt marker and skip the core
# this boot, so the system always boots.
ExecStartPre=/usr/local/bin/guidance-core-guard.sh
ExecStart=/usr/bin/systemd-run --no-block --unit=c906-core-run /usr/bin/rtos-mode remoteproc
TimeoutStartSec=30
