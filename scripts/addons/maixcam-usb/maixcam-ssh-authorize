#!/bin/sh
# Import trusted SSH public keys from the FAT boot partition.
set -eu

source_file=${MAIXCAM_AUTHORIZED_KEYS_FILE:-/boot/maixcam_authorized_keys}
target_dir=${MAIXCAM_SSH_TARGET_DIR:-/root/.ssh}
target_file=$target_dir/authorized_keys
validated_file=$(mktemp)

cleanup() {
  rm -f "$validated_file"
}
trap cleanup EXIT HUP INT TERM

# Deliberately inert.
#
# This used to arm usb-mode-autorevert.timer, which 180 s later ran
# `usb-mode-switch acm`, pulling the management gadget from NCM to ACM and
# taking the network away.  On this board password login is the norm and no
# boot key is provisioned, so the fallback fired on essentially every boot and
# looked like the board disconnecting itself.
#
# The fallback exists to stop a locked-out board from being unreachable.  We
# accept that tradeoff here: the recovery path is the serial console, which is
# the same USB port, and an unreachable board is worse than one that has to be
# reflashed.  If you want the guarantee back, drop the timer and service files
# back in and re-add the systemctl calls here.
arm_acm_recovery() {
  echo "No valid boot SSH key; management USB stays on NCM (ACM fallback disabled)" >&2
}

if [ ! -s "$source_file" ]; then
  arm_acm_recovery
  exit 0
fi

valid_count=0
while IFS= read -r line || [ -n "$line" ]; do
  line=$(printf '%s' "$line" | tr -d '\r')
  [ -n "$line" ] || continue
  case "$line" in
    ssh-ed25519\ *|ssh-rsa\ *|ecdsa-sha2-nistp256\ *|ecdsa-sha2-nistp384\ *|ecdsa-sha2-nistp521\ *|sk-ssh-ed25519@openssh.com\ *|sk-ecdsa-sha2-nistp256@openssh.com\ *)
      printf '%s\n' "$line" >>"$validated_file"
      valid_count=$((valid_count + 1))
      ;;
    *)
      echo "Invalid public key line in $source_file" >&2
      arm_acm_recovery
      exit 0
      ;;
  esac
done <"$source_file"

if [ "$valid_count" -eq 0 ]; then
  arm_acm_recovery
  exit 0
fi

if ! ssh-keygen -l -f "$validated_file" >/dev/null 2>&1; then
  echo "Public key validation failed for $source_file" >&2
  arm_acm_recovery
  exit 0
fi

install -d -m 0700 "$target_dir"
touch "$target_file"
chmod 0600 "$target_file"
while IFS= read -r line; do
  grep -Fqx -- "$line" "$target_file" || printf '%s\n' "$line" >>"$target_file"
done <"$validated_file"
