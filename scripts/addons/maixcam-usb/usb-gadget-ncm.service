[Unit]
Description=NCM USB Gadget Support
Before=usb-gadget.service
# NCM is the persistent management mode.  If an older image (or a manual
# experiment) left ACM/RNDIS enabled as well, start NCM last so it wins the
# conflict and the board does not come back as a COM port.
After=usb-gadget-acm.service usb-gadget-rndis.service
Conflicts=usb-gadget-acm.service
Conflicts=usb-gadget-rndis.service
Conflicts=usb-switch.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c "/bin/echo device > /proc/cviusb/otg_role"
ExecStart=sh /usr/sbin/run_usb.sh probe ncm
ExecStart=sh /usr/sbin/run_usb.sh start
# The image disables ifupdown's hotplug handling, so assign usb0's management
# address here; otherwise dnsmasq cannot bind and SSH never comes up.
ExecStartPost=/usr/local/sbin/usb0-ip.sh
ExecStop=sh /usr/sbin/run_usb.sh stop

[Install]
WantedBy=multi-user.target
