#!/bin/sh
# Switch SG2002 management USB between NCM/SSH and ACM recovery.
set -eu

run_usb=${MAIXCAM_RUN_USB:-/usr/sbin/run_usb.sh}
systemd_dir=${MAIXCAM_SYSTEMD_DIR:-/etc/systemd/system}

# Switching away from ACM stops usb-shell.service.  When this script is
# launched from ttyGS0 it therefore has to leave that service's cgroup before
# stop_gadget kills the shell and all of its children.
if [ "${1:-}" = "--apply" ]; then
  mode=${2:-}
else
  mode=${1:-}
  current_tty=$(tty 2>/dev/null || true)
  if [ "$current_tty" = "/dev/ttyGS0" ]; then
    case "$mode" in
      ncm|rndis|acm)
        systemd-run --no-block --collect "$0" --apply "$mode"
        exit 0
        ;;
    esac
  fi
fi

# Remove the 180 s ACM fallback that older images armed whenever no boot SSH
# key was present.  It switched the gadget to ACM behind the user's back and
# persisted that choice, which is why a replug could enumerate as "USB Com
# Port" instead of NCM.  Retire both the timer and its enable link so a card
# written with an old image self-heals on the next switch/boot.
retire_legacy_autorevert() {
  systemctl disable --now usb-mode-autorevert.timer 2>/dev/null || true
  rm -f "$systemd_dir/usb-mode-autorevert.timer" \
        "$systemd_dir/usb-mode-autorevert.service" \
        "$systemd_dir/timers.target.wants/usb-mode-autorevert.timer"
}

stop_gadget() {
  systemctl stop usb-gadget-ncm-usb0.service usb-gadget-rndis-usb0.service 2>/dev/null || true
  ifdown usb0 2>/dev/null || true
  systemctl stop --no-block usb-shell.service 2>/dev/null || true
  systemctl kill --kill-whom=all --signal=KILL usb-shell.service 2>/dev/null || true
  systemctl stop usb-gadget-ncm.service usb-gadget-acm.service usb-gadget-rndis.service 2>/dev/null || true
  if [ -d /sys/kernel/config/usb_gadget/cvitek ]; then
    sh "$run_usb" stop
  fi
}

wait_for_usb0() {
  attempt=0
  while [ ! -e /sys/class/net/usb0 ]; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 50 ]; then
      echo "usb0 did not appear" >&2
      return 1
    fi
    sleep 0.1
  done
}

retire_legacy_autorevert

case "$mode" in
  ncm|rndis)
    systemctl disable usb-shell.service usb-gadget-acm.service >/dev/null 2>&1 || true
    systemctl enable usb-gadget-ncm.service usb-gadget-ncm-usb0.service >/dev/null
    stop_gadget
    systemctl start usb-gadget-ncm.service
    wait_for_usb0
    ifup usb0 2>/dev/null || {
      ip address replace 10.42.0.1/24 dev usb0
      ip link set usb0 up
    }
    systemctl start usb-gadget-ncm-usb0.service
    ;;
  acm)
    # Recovery is deliberately one-shot.  Keep NCM as the persistent boot
    # mode and start the ACM gadget for this boot only; a reboot or replug
    # must return the board to the network gadget instead of leaving it
    # enumerating as a COM port.
    systemctl disable usb-shell.service usb-gadget-acm.service >/dev/null 2>&1 || true
    systemctl enable usb-gadget-ncm.service usb-gadget-ncm-usb0.service >/dev/null
    stop_gadget
    systemctl start usb-gadget-acm.service
    systemctl start usb-shell.service
    ;;
  *)
    echo "usage: $0 ncm|rndis|acm" >&2
    exit 2
    ;;
esac
