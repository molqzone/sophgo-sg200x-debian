# Inputs that define the reusable build-toolchain container.
# No digest pin: debian:sid is republished daily and Docker Hub garbage-collects
# old manifests within days, so a digest pin breaks the toolchain build with
# "not found" (it did twice).  Build immutability comes from DEBIAN_SNAPSHOT
# plus the pinned git commits; the base image only provides apt.
BUILDER_BASE_IMAGE=debian:sid
DEBIAN_SNAPSHOT=20260714T000000Z
HOST_TOOLS_REPO=https://github.com/milkv-duo/host-tools.git
HOST_TOOLS_COMMIT=67688c7335e7239f7592b86ed1432c97cbab245b
