[Unit]
Description=SC035HGS H264 camera bridge to Razver ESP32-C5
After=load-systemko.service sensor-config.service
ConditionPathExists=/dev/cvi-vi
ConditionPathExists=/usr/local/bin/sg2002-camera-bridge

[Service]
Type=simple
Environment=RAZVER_FPS=5
Environment=RAZVER_BITRATE=48
EnvironmentFile=-/etc/default/razver-camera
ExecStart=/usr/local/bin/sg2002-camera-bridge --fps ${RAZVER_FPS} --bitrate ${RAZVER_BITRATE}
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
