[Unit]
# 放核**不是**网络的前置条件。本单元原来继承 `Before=network-pre.target`（以及
# `Before=NetworkManager.service` / `wpa_supplicant`）：从核一旦起不来，整块板子就没有
# 网络、外观与“上电卡死”完全一样——这就是那个假砖头。清零这些排序：单元失败就只是一条
# failed 服务，板子照常可达。
# Releasing the core is **not** a precondition for the network.  The unit used to inherit
# `Before=network-pre.target` (and NetworkManager/wpa_supplicant): if the core did not come
# up, the board had no network and looked exactly like a dead board -- the "fake brick".
# Reset that ordering, so a failure is a failed unit on a reachable board.
#
# 不要再加 `After=network-online.target`：它与这里清掉的 `Before=NetworkManager.service`
# 构成排序环，systemd 会直接删掉 `load-systemko.service/start`——单元一次都不会跑。
# Do not add `After=network-online.target`: it forms an ordering cycle with the
# `Before=NetworkManager.service` cleared here and systemd deletes
# `load-systemko.service/start` outright, so the unit never runs at all.
Before=

[Service]

# 页由固件建立：bring-up 里 `Format()` 并证明它在 DRAM 可读（`Sync` 是 clean+invalidate，
# 见 shared-page-xr 的 `PageCore::Format()`），页头/遥测环/名字服务都归固件，Linux 只写
# 命令区。所以这里**没有**格式化的前置步骤——它曾经是必需的，因为固件当时只校验不复用
# 非全零页；现在页的所有权在写它的人手里。
# The firmware builds the page: `Format()` at bring-up, proven readable from DRAM (`Sync`
# is a clean+invalidate; see `PageCore::Format()`), and header/ring/name service all
# belong to it, while Linux only writes the command region.  So there is **no** format
# step here -- it used to be required because the firmware only validated a page it did
# not build; ownership now sits with whoever writes the bytes.
ExecStart=
# 参数由构建期的 `GUIDANCE_FW_LOADER` 推导，不是独立的配置项：remoteproc 意味着 Linux 写
# 固件并起核（`rtos-mode remoteproc`），fsbl 意味着加载器已经放核（`rtos-mode attach`）。
# 独立变量曾经把字面值 `load` 填进来——那不是 rtos-mode 的子命令，单元以 usage 退出 2，
# 核从未被放行。安装步骤现在对着 rtos-mode 的 case 分支核一遍。
# The argument follows from the build-time `GUIDANCE_FW_LOADER` instead of being a knob
# of its own: remoteproc means Linux writes the firmware and starts the core, fsbl means
# the loader already released it.  The knob it used to be once held `load`, which is not
# a rtos-mode subcommand -- the unit exited 2 and the core was never released.
ExecStart=/usr/bin/rtos-mode @GUIDANCE_FW_RPROC_COMMAND@

# 失败要**可见**：把退出码落到 /run，而不是让“服务没起来”变成“板子像砖”。
# A failure must be **visible**: record the exit status under /run instead of letting
# "the service did not come up" look like "the board is a brick".
Restart=no
ExecStopPost=/bin/sh -c 'test "$$EXIT_STATUS" = 0 || echo "c906 degraded (exit $$EXIT_STATUS)" > /run/c906-degraded'
